# Copy this file to .env and fill in your values.
# NEVER commit the real .env to git or include it in a release zip.

# Google Drive OAuth credentials (from Google Cloud Console)
GDRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your-client-secret

# Optional: override the data directory for config/snapshots/logs
# BACKUPSYS_DATA_DIR=C:\Users\you\AppData\Local\BackupSys

# Optional: SMTP password (avoids storing it in config.json)
# BACKUPSYS_EMAIL_PASSWORD=your-smtp-app-password

# Optional: per-watch Fernet encryption keys
# BACKUPSYS_ENCRYPT_KEY_DEFAULT=your-fernet-key
# BACKUPSYS_ENCRYPT_KEY_<WATCH_ID>=per-watch-key

# Optional: webhook URL for success/failure notifications (overrides config.json)
# BACKUPSYS_WEBHOOK_URL=https://your-webhook-endpoint.example.com/notify

# Optional: pause auto-backups on metered network connections (Windows only)
# BACKUPSYS_PAUSE_ON_METERED=true

# Optional: run in portable mode — store config/logs next to the .exe instead of AppData
# BACKUPSYS_PORTABLE=true

# ── API server (backupsys_api.py) ─────────────────────────────────────────────
# Required for dashboard login & session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BACKUPSYS_SESSION_SECRET=generate-with-python-secrets-token-hex-32

# Required to enable the /dashboard login UI.
# Use a strong, unique password — this is your only dashboard gate.
BACKUPSYS_DASHBOARD_PASSWORD=your-dashboard-password

# CORS — controls which origins may call the API from a browser.
# Set to * to allow all origins, or restrict to your dashboard's URL.
# Leave unset to send no CORS headers (safest for server-to-server use).
# ALLOWED_ORIGINS=https://your-dashboard.example.com

# Required when running the API server: shared secret for HMAC request signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# BACKUPSYS_API_KEY=your-api-key-min-32-chars

# Set to true when the API server runs behind a reverse proxy (Railway, Render,
# Fly.io, nginx, etc.) so the rate limiter reads the real client IP from
# X-Forwarded-For instead of the proxy's address. Leave unset for direct deployments.
# BACKUPSYS_TRUSTED_PROXY=true